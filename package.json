{
  "name": "astro-keystatic-starter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "22.23.4",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "dev": "pnpm run \"/^dev:(site|admin)$/\"",
    "dev:site": "pnpm --filter @starter/site dev --port 4321",
    "dev:admin": "pnpm --filter @starter/admin dev --port 4322",
    "dev:stop": "pnpm -r --parallel --no-bail --filter @starter/site --filter @starter/admin exec astro dev stop",
    "deploy:admin:preview": "pnpm --filter @starter/admin deploy:preview",
    "deploy:admin:production": "pnpm --filter @starter/admin deploy:production",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --passWithNoTests",
    "build": "pnpm --filter @starter/site build && pnpm --filter @starter/admin build",
    "build:site": "pnpm --filter @starter/site build",
    "build:admin:preview": "pnpm --filter @starter/admin build",
    "build:admin:production": "pnpm --filter @starter/admin build:production",
    "preview:site": "pnpm --filter @starter/site preview",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:site",
    "prepare": "husky",
    "verify:site": "node scripts/verify-site.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.1",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "vitest": "5.1.0",
    "typescript": "6.0.3",
    "@types/node": "26.6.6",
    "axe-core": "4.14.0",
    "yaml": "2.9.1"
  }
}
