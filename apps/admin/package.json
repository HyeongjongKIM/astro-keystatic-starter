    "setup:app": "astro dev --config astro.setup.config.mjs --mode production"
  },
  "dependencies": {
    "astro": "7.4.7",
    "@starter/config": "workspace:*",
    "@starter/content": "workspace:*",
    "@astrojs/cloudflare": "14.4.6",
    "@astrojs/react": "7.1.4",
    "@astrojs/markdoc": "2.1.3",
    "@keystatic/astro": "6.0.0",
    "@keystatic/core": "0.6.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3",
    "wrangler": "4.158.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
