{
  "name": "@starter/admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --mode preview",
    "build": "astro build --mode preview",
    "preview": "astro preview",
    "typecheck": "astro check",
    "build:production": "astro build --config astro.production.config.mjs --mode production",
    "deploy:preview": "pnpm build && wrangler deploy",
