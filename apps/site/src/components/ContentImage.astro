---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: string | ImageMetadata;
  alt?: string;
  title?: string;
}
const { src, alt = '', title } = Astro.props;
const assets = import.meta.glob<ImageMetadata>(
  '../assets/images/**/*.{png,jpg,jpeg,webp,avif,gif,svg}',
  { eager: true, import: 'default' },
);
const image =
  typeof src === 'string' ? assets[src.replace('@assets/', '../assets/')] : src;
if (!image)
  throw new Error(
    `Unknown content image "${src}": upload to the configured assets directory`,
  );
---

<Image
  src={image}
  alt={alt}
  title={title}
  loading="lazy"
  decoding="async"
  format="webp"
/>
