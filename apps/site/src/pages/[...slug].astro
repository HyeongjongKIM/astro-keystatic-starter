---
import { reader } from '../lib/content';
import PageLayout from '../layouts/PageLayout.astro';
import {
  buildPageTree,
  breadcrumbs,
  HOME_SLUG,
  type PageNode,
  type Breadcrumb,
} from '@starter/content/navigation';
export async function getStaticPaths() {
  const tree = buildPageTree(await reader.collections.pages.all());
  return [...tree.bySlug.values()].map((page) => ({
    params: { slug: page.slug === HOME_SLUG ? undefined : page.slug },
    props: { page, trail: breadcrumbs(tree, page.slug) },
  }));
}
interface Props {
  page: PageNode;
  trail: Breadcrumb[];
}
const { page, trail } = Astro.props;
---

<PageLayout page={page} trail={trail} />
