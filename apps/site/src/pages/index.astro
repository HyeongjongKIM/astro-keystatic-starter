---
import { reader } from '../lib/content';
import ContentBody from '../components/ContentBody.astro';
const page = await reader.collections.pages.readOrThrow('home');
const settings = await reader.singletons.siteSettings.readOrThrow();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{settings.siteName}</title>
  </head>
  <body>
    <h1>{page.title}</h1>
    <ContentBody collection="pages" slug="home" blocks={page.content} />
  </body>
</html>
